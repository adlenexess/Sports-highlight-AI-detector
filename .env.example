# API Security Configuration (Optional)
# Leave empty or set to "False" to disable. Only set if you want additional security.

# Optional: Add API key requirement
# Set to a secret string to require X-API-Key header on /api/generate requests
# If not set or empty, API is open (current behavior)
# API_KEY=

# Optional: Rate limiting (requests per minute per IP)
# Leave empty to disable rate limiting
# RATE_LIMIT_PER_MINUTE=60

# Optional: Enable request logging
# Set to True to log all API requests to a file
# API_REQUEST_LOGGING=False

# Database
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=highlight_db

# Upload limits
MAX_UPLOAD_SIZE_MB=500
